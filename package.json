{
  "name": "pipeline-aware-forecast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source module that feeds weighted Salesforce pipeline demand into deterministic Shopify inventory forecasting.",
  "license": "MIT",
  "author": "Arsalan Arshad",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "start": "react-router-serve ./build/server/index.js",
    "setup": "prisma generate && prisma migrate deploy",
    "docker-start": "npm run setup && npm run start",
    "test": "node --test",
    "test:integration": "node --env-file=.env --test test/salesforce-client.integration.test.js",
    "test:db": "node --test test/database.integration.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-router/fs-routes": "^7.18.4",
    "@react-router/node": "^7.18.4",
    "@react-router/serve": "^8.4.0",
    "@shopify/polaris": "^13.9.0",
    "@shopify/shopify-app-react-router": "^3.0.2",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "isbot": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.4",
    "esbuild": "^0.28.2",
    "prisma": "^6.19.3",
    "vite": "^6.4.4"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
