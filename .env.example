# PLANNED variables — nothing reads these yet. If built as a module of AI Forecast Agent,
# these simply join that app's .env.example. Never put real values in this file.

# Postgres connection string for the app database (Railway provides this).
DATABASE_URL=

# 32-byte key used to encrypt merchants' Salesforce credentials at rest.
# Without it the Salesforce settings page cannot save credentials.
# Generate locally with: openssl rand -hex 32
ENCRYPTION_KEY=

# Merchant Salesforce credentials are entered in the app UI and stored encrypted in the database,
# not in environment variables.

# Only for `npm run test:integration` against your own Salesforce org (the live read-only
# client test). The app itself stores merchant credentials encrypted in the database.
# SF_INSTANCE_URL is your My Domain address, e.g. https://yourcompany.my.salesforce.com
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Shopify app (created by the app owner in their Shopify dashboard; never commit real values).
# `shopify app dev` fills these in locally once the app is linked.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_inventory,read_locations,read_orders,read_products

# Scheduler: a cron job (e.g. Railway cron) POSTs to /internal/sync with `Authorization: Bearer <CRON_SECRET>`.
# Use a long random value (>= 32 chars, e.g. `openssl rand -hex 24`). Leave unset to disable the endpoint.
CRON_SECRET=
